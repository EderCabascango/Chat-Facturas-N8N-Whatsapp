        300,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-latest:generateContent",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "AIzaSyBaa_XL_t_hATtq8t9tqymVJYFNtJVZzs0"
        }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"Eres un experto en extracción de datos. Analiza esta imagen de una transferencia del Banco Pichincha y extrae: fecha, monto, número de referencia y nombre del remitente (o beneficiario). Devuelve ÚNICAMENTE un JSON estricto con las claves: fecha, monto, referencia, remitente.\"\n        },\n        {\n          \"inline_data\": {\n            \"mime_type\": \"image/jpeg\",\n            \"data\": \"{{ $node['Fetch Image Base64'].json.base64 }}\"\n          }\n        }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
      "name": "Gemini 1.5 Flash (API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "try {\n  const text = $input.first().json.candidates[0].content.parts[0].text;\n  const jsonStr = text.replace(/```json\\n?|```/g, '').trim();\n  return [ { json: JSON.parse(jsonStr) } ];\n} catch (e) {\n  return [ { json: { error: e.message, raw: $input.first().json } } ];\n}"
      },
      "name": "Parse JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "1RlwWAf20k-A1sjNp9gPURaFmUMPSz5xNdIAAhdaC350",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Hoja 1",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Fecha": "={{ $json.fecha }}",
            "Monto": "={{ $json.monto }}",
            "Referencia": "={{ $json.referencia }}",
            "Remitente": "={{ $json.remitente }}"
          }
        },
        "options": {}
      },
      "name": "Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.1,
