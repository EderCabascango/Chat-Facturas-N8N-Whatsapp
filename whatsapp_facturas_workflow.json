{
  "id": "whatsapp_facturas_final_1",
  "name": "WhatsApp Multibanco to Mobile App",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook (Evolution API)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [ 100, 300 ]
    },
    {
      "parameters": {
        "url": "={{ ($json.body.data.message.imageMessage || $json.body.data.message.documentMessage) ? 'http://evolution_api:8080/chat/getBase64FromMediaMessage/pichincha' : '' }}",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "message",
              "value": "={{ $json.body.data }}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.AUTHENTICATION_API_KEY }}"
            }
          ]
        }
      },
      "name": "Fetch Base64",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [ 300, 300 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "={{ $env.GEMINI_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"Actúa como un experto contable. Analiza el documento o imagen del comprobante bancario. Extrae: Banco, Fecha, Monto (solo número), Número de Comprobante y Nombre del Emisor. Devuelve estrictamente un JSON plano sin texto adicional.\"\n        },\n        {\n          \"inline_data\": {\n            \"mime_type\": \"{{ $node['Webhook (Evolution API)'].json.body.data.message.imageMessage ? 'image/jpeg' : 'application/pdf' }}\",\n            \"data\": \"{{ $node['Fetch Base64'].json.base64 }}\"\n          }\n        }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
      "name": "Gemini 1.5 Flash",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [ 500, 300 ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "try {\n  const text = $input.first().json.candidates[0].content.parts[0].text;\n  const jsonStr = text.replace(/```json\\n?|```/g, '').trim();\n  return [ { json: JSON.parse(jsonStr) } ];\n} catch (e) {\n  return [ { json: { error: e.message, raw: $input.first().json } } ];\n}"
      },
      "name": "Parse JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [ 700, 300 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://fuyu_dashboard:3000/api/webhook",
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.FUYU_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {}
      },
      "name": "Send to Mobile App (Webhook)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [ 900, 300 ]
    }
  ],
  "connections": {
    "Webhook (Evolution API)": {
      "main": [
        [
          {
            "node": "Fetch Base64",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Base64": {
      "main": [
        [
          {
            "node": "Gemini 1.5 Flash",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gemini 1.5 Flash": {
      "main": [
        [
          {
            "node": "Parse JSON",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse JSON": {
      "main": [
        [
          {
            "node": "Send to Mobile App (Webhook)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
